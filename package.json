{
  "name": "local-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Agendamentos locais para macOS com SQL e scripts",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "electron": "^44.6.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
